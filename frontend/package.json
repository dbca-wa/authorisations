{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude=\"src/**/*.integration.test.ts\" --exclude=\"src/**/*.integration.test.tsx\"",
    "test:integration": "vitest run --include=\"src/**/*.integration.test.ts\" --include=\"src/**/*.integration.test.tsx\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@tailwindcss/vite": "^4.3.4",
    "axios": "^1.21.0",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.4",
    "underscore": "^1.13.8",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.95",
    "@iconify/tailwind4": "^1.2.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/underscore": "^1.13.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
